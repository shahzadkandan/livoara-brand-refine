<header class="site-header">
  <div class="header-inner">
    <button class="button icon menu-trigger" type="button" aria-label="Open menu" data-open-menu>{% render 'icon-menu' %}</button>
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">{% if section.settings.logo != blank %}<img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" width="110" loading="eager">{% else %}LIVOARA{% endif %}</a>
    <nav class="nav" aria-label="Main navigation">
      {% if section.settings.menu.links != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="/collections/all">Shop</a><a href="/pages/about">Our Story</a><a href="/pages/shipping-returns">Shipping &amp; Returns</a><a href="/pages/contact">Contact</a>
      {% endif %}
    </nav>
    <div class="header-actions">
      <button class="button icon" type="button" aria-label="Open cart" data-open-cart style="position:relative">{% render 'icon-bag' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></button>
    </div>
  </div>
</header>
<div class="mobile-menu" data-mobile-menu>
  <aside class="mobile-panel">
    <div class="mobile-panel-head"><span class="brand">LIVOARA</span><button class="button icon" data-close-menu aria-label="Close menu">×</button></div>
    <nav><a href="{{ routes.root_url }}">Home</a>{% if section.settings.menu.links != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="/collections/all">Shop</a><a href="/pages/about">Our Story</a><a href="/pages/shipping-returns">Shipping &amp; Returns</a><a href="/pages/contact">Contact</a>{% endif %}</nav>
  </aside>
</div>
{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"}]}{% endschema %}
