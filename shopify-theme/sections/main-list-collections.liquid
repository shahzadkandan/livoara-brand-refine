<section class="section-large container">
  <p class="eyebrow">Collections</p>
  <h1 class="title-xl" style="margin-top:.75rem">Shop by collection</h1>
  <div class="collection-grid" style="margin-top:2rem">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <article class="product-card">
          <a href="{{ collection.url }}">
            <figure>{% if collection.image %}<img src="{{ collection.image | image_url: width: 700 }}" alt="{{ collection.image.alt | default: collection.title | escape }}">{% else %}<img src="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" alt="{{ collection.title | escape }}">{% endif %}</figure>
          </a>
          <div class="product-card-content"><a href="{{ collection.url }}"><h2 class="title-md">{{ collection.title }}</h2></a><p class="copy">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p></div>
        </article>
      {% endunless %}
    {% else %}
      <div class="empty-state"><h2 class="title-md">No collections found</h2></div>
    {% endfor %}
  </div>
</section>
{% schema %}{"name":"Collections list","settings":[]} {% endschema %}