{% liquid
  assign featured_product = section.settings.featured_product
  if featured_product == blank
    assign featured_product = collections.all.products.first
  endif
  assign product_url = '/collections/all'
  if featured_product != blank
    assign product_url = featured_product.url
  endif
%}
<div class="page-reveal">
  <section class="hero" aria-label="Made for every moment">
    <h1 style="position:absolute;width:1px;height:1px;overflow:hidden">LIVOARA — Made for every moment.</h1>
    <a href="{{ product_url }}" aria-label="Shop the LIVOARA Travel Vanity">
      {% if section.settings.hero_image != blank %}<img src="{{ section.settings.hero_image | image_url: width: 2400 }}" alt="{{ section.settings.hero_image.alt | default: 'LIVOARA Travel Vanity' | escape }}" loading="eager">{% else %}<img src="{{ 'livoara-hero.png' | asset_url }}" alt="LIVOARA illuminated travel vanity with mirror, beauty products and jewellery" loading="eager">{% endif %}
    </a>
    <div class="hero-mobile-cta"><a class="button full" href="{{ product_url }}">Shop Now →</a></div>
  </section>
  <section class="icon-strip"><div class="icon-strip-grid"><div class="icon-strip-item">▦ <span>Organised storage</span></div><div class="icon-strip-item">☼ <span>LED mirror</span></div><div class="icon-strip-item">▱ <span>Travel-friendly</span></div><div class="icon-strip-item">◇ <span>Stylish & modern</span></div></div></section>
  <section class="section-large" style="background:color-mix(in oklch,var(--muted),transparent 50%)"><div class="container split"><div><p class="eyebrow">Everyday problems, considered</p><h2 class="title-lg" style="margin-top:.75rem">A smarter way to get ready.</h2><p class="copy" style="margin-top:1rem;max-width:28rem">LIVOARA brings your mirror, light and organised storage together, so your everyday routine feels clear and considered.</p><ul class="benefit-list"><li><span class="tick">✓</span>Everything visible at a glance</li><li><span class="tick">✓</span>Light where you need it</li><li><span class="tick">✓</span>One case from home to travel</li><li><span class="tick">✓</span>Less clutter, calmer routine</li></ul><a class="button secondary" style="margin-top:1.75rem" href="{{ product_url }}">Discover LIVOARA →</a></div><div class="video-frame"><video src="{{ 'livoara-uploaded-routine.mp4' | asset_url }}" poster="{{ 'livoara-product-white-sunlight.jpg' | asset_url }}" muted loop playsinline controls preload="metadata"></video><span class="play-badge">▷</span></div></div></section>
  <section class="section container"><h2 class="title-lg">Designed for your daily ritual.</h2><p class="copy" style="margin-top:.75rem;max-width:34rem">Every detail is made to keep your makeup organised, beautifully lit and easy to reach.</p><div class="feature-grid" style="margin-top:1.75rem"><article class="feature-card"><img src="{{ 'livoara-product-white-sunlight.jpg' | asset_url }}" alt="LED mirror"><h3>LED mirror for a clear finish</h3><p class="copy">Get ready with bright, even light wherever you are.</p></article><article class="feature-card"><img src="{{ 'livoara-category-lifestyle.jpg' | asset_url }}" alt="Everyday essentials"><h3>Room for your everyday essentials</h3><p class="copy">Keep palettes, brushes, skincare and accessories together.</p></article><article class="feature-card"><img src="{{ 'livoara-product-detail.jpg' | asset_url }}" alt="Smart compartments"><h3>Smart compartments</h3><p class="copy">Dedicated spaces make every product easy to see and pick.</p></article><article class="feature-card"><img src="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" alt="Compact vanity"><h3>Compact, elegant and portable</h3><p class="copy">Bring your vanity routine from bedroom to suitcase with ease.</p></article></div></section>
  <section class="section" style="background:var(--secondary)"><div class="container"><div class="split"><div><p class="eyebrow">Problem to solution</p><h2 class="title-lg" style="margin-top:.75rem">Sound familiar?</h2></div><p class="copy">Two everyday frustrations, followed by the LIVOARA way to get ready.</p></div><div class="problem-grid" style="margin-top:1.75rem"><article class="problem-card"><figure><img src="{{ 'livoara-problem-scattered.jpg' | asset_url }}" alt="Makeup everywhere"><span class="tag">Problem</span></figure><div class="card-pad"><h3>Makeup everywhere</h3><p class="copy">Essentials spread across the dresser.</p></div></article><article class="problem-card"><figure><img src="{{ 'livoara-problem-hidden.jpg' | asset_url }}" alt="Always searching"><span class="tag">Problem</span></figure><div class="card-pad"><h3>Always searching</h3><p class="copy">Small favourites hidden at the bottom.</p></div></article><article class="problem-card"><figure><img src="{{ 'livoara-category-women.jpg' | asset_url }}" alt="Everything organised"><span class="tag">LIVOARA solution</span></figure><div class="card-pad"><h3>Everything in its place</h3><p class="copy">The LIVOARA organiser keeps essentials together.</p></div></article><article class="problem-card"><figure><img src="{{ 'livoara-category-beauty.jpg' | asset_url }}" alt="Mirror light"><span class="tag">LIVOARA solution</span></figure><div class="card-pad"><h3>Light where you need it</h3><p class="copy">The illuminated mirror supports each detail.</p></div></article></div></div></section>
  <section class="section container"><div class="split"><div><p class="eyebrow">See it in your routine</p><h2 class="title-lg" style="margin-top:.5rem">Designed to be used, beautifully.</h2></div><p class="copy">Real-life moments show how light, storage and portability come together.</p></div><div class="video-grid" style="margin-top:1.5rem"><article class="video-card"><video src="{{ 'livoara-uploaded-organise.mp4' | asset_url }}" poster="{{ 'livoara-woman-organise.jpg' | asset_url }}" muted loop playsinline controls preload="metadata"></video><h3>Organise your essentials</h3><p class="copy">Keep everyday beauty pieces visible and together.</p></article><article class="video-card"><video src="{{ 'livoara-uploaded-routine.mp4' | asset_url }}" poster="{{ 'livoara-woman-routine.jpg' | asset_url }}" muted loop playsinline controls preload="metadata"></video><h3>Create your light</h3><p class="copy">Bring an illuminated mirror into the getting-ready moment.</p></article><article class="video-card"><video src="{{ 'livoara-uploaded-travel.mp4' | asset_url }}" poster="{{ 'livoara-woman-travel.jpg' | asset_url }}" muted loop playsinline controls preload="metadata"></video><h3>Pack one considered case</h3><p class="copy">Move from dresser to travel with one compact format.</p></article></div></section>
  <section class="section container"><p class="eyebrow">Collection</p><h2 class="title-lg" style="margin-top:.75rem">Future Categories</h2><div class="category-grid" style="margin-top:1.75rem">{% assign labels = 'Women,Men,Beauty,Lifestyle,Gifts,Accessories,POD,Travel Vanity' | split: ',' %}{% assign imgs = 'livoara-category-women.jpg,livoara-category-men.jpg,livoara-category-beauty.jpg,livoara-category-lifestyle.jpg,livoara-category-gifts.jpg,livoara-category-accessories.jpg,livoara-category-pod.jpg,livoara-product-pink-stacked.jpg' | split: ',' %}{% for label in labels %}<a class="category-card" href="{{ product_url }}"><figure><img src="{{ imgs[forloop.index0] | asset_url }}" alt="{{ label }} category"></figure><div><h3 class="font-display">{{ label }}</h3><span>↗</span></div></a>{% endfor %}</div></section>
  <section class="editorial-banner"><img src="{{ 'livoara-editorial-banner.jpg' | asset_url }}" alt="Open blush pink LIVOARA travel vanity"><div class="container editorial-banner-content"><div><h2 class="title-lg">Designed for your everyday,<br>beautiful wherever you go.</h2><a class="button" style="margin-top:1.25rem" href="{{ product_url }}">Shop Now →</a><p class="editorial-note">Compact.<br>Chic.<br>Yours.</p></div></div></section>
  <section class="section container"><p class="eyebrow">Problem vs solution · us vs them</p><h2 class="title-lg" style="margin-top:.75rem">A better way to get ready.</h2><p class="copy" style="margin-top:.75rem;max-width:34rem">See how a dedicated LED makeup box creates a more considered routine than scattered storage.</p><div class="compare-wrap" style="margin-top:1.5rem"><table class="compare-table"><thead><tr><th></th><th>Loose on a vanity</th><th>Generic organiser</th><th class="highlight">LIVOARA</th></tr></thead><tbody><tr><th>Organised storage</th><td>Scattered</td><td>General storage</td><td class="highlight">Dedicated compartments</td></tr><tr><th>Mirror lighting</th><td>Separate mirror</td><td>Usually separate</td><td class="highlight">Illuminated mirror</td></tr><tr><th>Getting-ready format</th><td>Multiple items</td><td>Storage focused</td><td class="highlight">Mirror and storage together</td></tr><tr><th>Travel format</th><td>Separate pouches</td><td>Varies by design</td><td class="highlight">Compact vanity case</td></tr><tr><th>Launch price</th><td>Not applicable</td><td>Varies</td><td class="highlight">From {{ featured_product.price | default: 149900 | money }}</td></tr></tbody></table></div></section>
  <section class="section" style="background:color-mix(in oklch,var(--muted),transparent 30%)"><div class="container"><p class="eyebrow">Customer reviews</p><h2 class="title-lg" style="margin-top:.75rem;max-width:38rem">Thoughtful details, noticed in real routines.</h2>{% render 'sample-reviews' %}</div></section>
  <section class="section container" style="max-width:760px;text-align:center"><p class="eyebrow">Helpful details</p><h2 class="title-lg" style="margin-top:.75rem">Questions, answered.</h2><div class="faq-list" style="margin-top:1.5rem;text-align:left"><details class="info-row" open><summary>What can I store in the LED makeup box?<span>+</span></summary><p class="copy">It is designed to organise everyday makeup, brushes, skincare, jewellery, and other small beauty essentials. Fit depends on the size and shape of each item.</p></details><details class="info-row"><summary>How does the illuminated mirror work?<span>+</span></summary><p class="copy">Use the controls and power instructions supplied with your product. Please read the product label and enclosed guide before first use.</p></details><details class="info-row"><summary>How long does delivery take?<span>+</span></summary><p class="copy">The estimated delivery timeline and any applicable shipping charge are shown at checkout for your location. Tracking is shared after dispatch where available.</p></details><details class="info-row"><summary>What if my order arrives damaged or incorrect?<span>+</span></summary><p class="copy">Email hello@livoara.in within 7 calendar days of delivery. A clear, continuous unboxing video is required so our team can assess the request under the Shipping & Returns Policy.</p></details></div></section>
  <section class="section" style="position:relative;background:var(--secondary);overflow:hidden"><img src="{{ 'livoara-product-white-sunlight.jpg' | asset_url }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.2"><div style="position:absolute;inset:0;background:color-mix(in oklch,var(--secondary),transparent 10%)"></div><div class="container" style="position:relative"><div class="split"><div><p class="eyebrow">Your everyday vanity</p><h2 class="title-lg" style="margin-top:.75rem">Give your beauty routine<br>the light it deserves.</h2></div><a class="button" href="{{ product_url }}">Shop Now →</a></div><div class="trust-grid" style="margin-top:2rem"><div class="trust-item">▱<br>Shipping<br><small class="muted">Timeline at checkout</small></div><div class="trust-item">↻<br>Easy returns<br><small class="muted">7-day request window</small></div><div class="trust-item">⌕<br>Secure payments<br><small class="muted">Protected options</small></div><div class="trust-item">☎<br>Customer care<br><small class="muted">hello@livoara.in</small></div></div></div></section>
</div>
{% schema %}{"name":"LIVOARA home","settings":[{"type":"product","id":"featured_product","label":"Featured product"},{"type":"image_picker","id":"hero_image","label":"Hero image"}],"presets":[{"name":"LIVOARA home"}]}{% endschema %}
