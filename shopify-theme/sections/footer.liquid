<footer class="footer">
  <div class="footer-inner">
    <div>
      <a href="{{ routes.root_url }}" class="brand">{{ shop.name | default: 'LIVOARA' }}</a>
      <p style="margin-top:1.25rem;max-width:24rem;line-height:1.7">{{ settings.footer_brand_text }}</p>
    </div>
    <div>
      <h2>Explore</h2>
      <div class="footer-links">
        {% assign footer_menu = section.settings.footer_menu | default: settings.footer_menu %}
        {% for link in linklists[footer_menu].links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      </div>
    </div>
    <div>
      <h2>Policies &amp; Customer Care</h2>
      <div class="footer-links">
        {% assign policy_menu = section.settings.policy_menu | default: settings.policy_menu %}
        {% for link in linklists[policy_menu].links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
        <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">© {{ 'now' | date: '%Y' }} {{ settings.copyright_text }} · All rights reserved</div>
</footer>
{% schema %}
{"name":"Footer","settings":[{"type":"link_list","id":"footer_menu","label":"Explore menu","default":"footer"},{"type":"link_list","id":"policy_menu","label":"Policy menu","default":"footer"}]}
{% endschema %}