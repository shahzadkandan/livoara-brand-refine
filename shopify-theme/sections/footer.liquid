<footer class="footer">
  <div class="footer-inner">
    <div><a href="{{ routes.root_url }}" class="brand">LIVOARA</a><p style="margin-top:1.25rem;max-width:24rem;line-height:1.7">A thoughtful vanity made to hold the little things that make every moment yours.</p></div>
    <div><h2>Explore</h2><div class="footer-links">{% for link in section.settings.explore_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div></div>
    <div><h2>Policies & Customer Care</h2><div class="footer-links">{% for link in section.settings.policy_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}<a href="mailto:hello@livoara.in">hello@livoara.in</a></div></div>
  </div>
  <div class="footer-bottom">© {{ 'now' | date: '%Y' }} LIVOARA · A brand of ARINJJOY VENTURES · GSTIN 21ACMFA2803PIZE · All rights reserved</div>
</footer>
{% schema %}{"name":"Footer","settings":[{"type":"link_list","id":"explore_menu","label":"Explore menu","default":"main-menu"},{"type":"link_list","id":"policy_menu","label":"Policy menu","default":"footer"}]}{% endschema %}
