<div class="page-reveal" data-product-root>
  <div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {{ product.title }}</div>
  <section class="product-main container-wide section">
    <div class="product-gallery-wrap">
      <div class="gallery-shell">
        <div class="gallery-main" data-gallery-main>
          {% if product.media.size > 0 %}{% for media in product.media limit: 8 %}<div data-media-panel="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}">{% case media.media_type %}{% when 'image' %}<img src="{{ media | image_url: width: 1400 }}" alt="{{ media.alt | escape }}">{% when 'video' %}{{ media | video_tag: controls: true, image_size: '1200x', autoplay: true, loop: true, muted: true }}{% else %}{{ media | media_tag }}{% endcase %}</div>{% endfor %}{% else %}<div data-media-panel="0" class="active"><img src="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" alt="{{ product.title }}"></div><div data-media-panel="1"><img src="{{ 'livoara-reference-vanity.jpg' | asset_url }}" alt="{{ product.title }}"></div><div data-media-panel="2"><img src="{{ 'livoara-hero.png' | asset_url }}" alt="{{ product.title }}"></div><div data-media-panel="3"><img src="{{ 'livoara-product-white-sunlight.jpg' | asset_url }}" alt="{{ product.title }}"></div>{% endif %}<span class="tag" style="position:absolute;left:.75rem;top:.75rem">Gallery</span><span class="zoom-lens" data-zoom-lens></span>
        </div><div class="zoom-panel" data-zoom-panel><img src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 }}{% else %}{{ 'livoara-product-pink-stacked.jpg' | asset_url }}{% endif %}" alt=""></div>
      </div>
      <div class="thumbs">{% if product.media.size > 0 %}{% for media in product.media limit: 8 %}<button class="thumb {% if forloop.first %}active{% endif %}" type="button" data-thumb="{{ forloop.index0 }}" {% if media.preview_image %}data-zoom="{{ media.preview_image | image_url: width: 1400 }}"{% endif %}>{% if media.preview_image %}<img src="{{ media.preview_image | image_url: width: 220 }}" alt="">{% endif %}</button>{% endfor %}{% else %}{% assign fallback = 'livoara-product-pink-stacked.jpg,livoara-reference-vanity.jpg,livoara-hero.png,livoara-product-white-sunlight.jpg' | split: ',' %}{% for img in fallback %}<button class="thumb {% if forloop.first %}active{% endif %}" type="button" data-thumb="{{ forloop.index0 }}" data-zoom="{{ img | asset_url }}"><img src="{{ img | asset_url }}" alt=""></button>{% endfor %}{% endif %}</div>
      <p class="copy" style="text-align:center;font-size:.72rem;margin-top:.5rem">Hover to preview media. Move over a product image to zoom.</p>
    </div>
    <div>
      <div style="display:flex;flex-wrap:wrap;gap:.5rem;border-bottom:1px solid var(--border);padding-bottom:.75rem;font-size:.8rem"><a href="#reviews" style="font-weight:700;text-decoration:underline;text-underline-offset:4px">Illustrative customer conversations</a><span class="muted">Sample feedback · verified reviews added after collection</span></div>
      <p class="eyebrow" style="margin-top:1rem;color:var(--muted-foreground)">LIVOARA signature beauty companion</p><h1 class="title-lg" style="margin-top:.5rem">{{ product.title }}</h1><div class="copy" style="margin-top:.85rem">{{ product.description | default: 'A luminous vanity, thoughtful organizer, and travel companion—beautifully designed as one.' }}</div>
      {% assign current_variant = product.selected_or_first_available_variant %}
      {% form 'product', product, id: 'ProductForm' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <div class="offer-box"><div class="offer-head"><div><p class="eyebrow">Current bundle offer</p><h2 class="title-md" style="margin-top:.2rem">Save more when you bundle.</h2></div><span class="tag">Bundle pricing</span></div><p style="font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;font-weight:700;margin-bottom:.55rem">Choose your offer</p><div class="variant-grid">{% for variant in product.variants %}{% assign selected = false %}{% if variant.id == current_variant.id %}{% assign selected = true %}{% endif %}<div><input class="variant-radio" data-variant-radio id="variant-{{ variant.id }}" type="radio" name="variant-choice" value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% if selected %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}><label class="variant-card" for="variant-{{ variant.id }}"><span style="display:flex;gap:.75rem;align-items:center"><span class="radio-dot"></span><span><strong>{{ variant.title }}</strong>{% if variant.title contains '2' %}<span class="tag" style="margin-left:.45rem">Popular</span>{% elsif variant.title contains '3' %}<span class="tag" style="margin-left:.45rem">Best value</span>{% endif %}<small class="muted" style="display:block;margin-top:.15rem">{% if variant.available %}Available{% else %}Sold out{% endif %}</small></span></span><span>{% if variant.compare_at_price > variant.price %}<span class="compare-price">{{ variant.compare_at_price | money }}</span>{% endif %}<strong class="price">{{ variant.price | money }}</strong></span></label></div>{% endfor %}</div><div style="margin-top:.65rem;background:color-mix(in oklch,var(--muted),transparent 55%);padding:.6rem;font-size:.75rem">Selected: <strong data-selected-price>{{ current_variant.price | money }}</strong> · Inclusive of all taxes</div></div>
        <ul class="benefit-list" style="grid-template-columns:repeat(2,1fr)"><li><span class="tick">✓</span>Illuminated mirror for your beauty ritual</li><li><span class="tick">✓</span>Organised sections for everyday essentials</li><li><span class="tick">✓</span>Compact format designed for travel</li><li><span class="tick">✓</span>Mirror, light and storage in one case</li></ul>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1.25rem"><span class="eyebrow" style="color:var(--foreground)">Quantity</span><div class="qty"><button type="button" onclick="this.nextElementSibling.stepDown();this.nextElementSibling.dispatchEvent(new Event('change',{bubbles:true}))">−</button><input name="quantity" value="1" min="1" type="number"><button type="button" onclick="this.previousElementSibling.stepUp();this.previousElementSibling.dispatchEvent(new Event('change',{bubbles:true}))">+</button></div></div>
        <div class="offer-box" style="border-color:var(--border)" data-countdown data-seconds="10218"></div>
        <button class="button full" data-main-atc data-price-button type="submit" {% unless current_variant.available %}disabled{% endunless %}>Add to Cart · {{ current_variant.price | money }}</button><button class="button secondary full" style="margin-top:.55rem" type="submit" data-buy-now {% unless current_variant.available %}disabled{% endunless %}>Buy Now</button>
      {% endform %}
      <div class="promise" style="margin-top:.75rem"><p style="text-align:center;font-size:.66rem;text-transform:uppercase;letter-spacing:.18em;opacity:.7;font-weight:700">LIVOARA shop promise</p><div class="promise-grid"><div class="promise-item"><strong>Fast Shipping</strong><br><span style="opacity:.72">Timeline shown at checkout</span></div><div class="promise-item"><strong>Easy Returns</strong><br><span style="opacity:.72">7-day request window</span></div><div class="promise-item"><strong>Secure Payments</strong><br><span style="opacity:.72">Trusted payment options</span></div><div class="promise-item"><strong>Careful Delivery</strong><br><span style="opacity:.72">Tracking where available</span></div></div></div>
      <p class="copy" style="text-align:center;font-size:.72rem;margin-top:.55rem">UPI · RuPay · Visa · Mastercard · G Pay · PhonePe · Paytm · COD where available</p>
      <div style="margin-top:1rem;border-block:1px solid var(--border)"><details class="info-row" open><summary>Product Details<span>⌄</span></summary><div class="copy">{{ product.description | default: 'The LIVOARA Travel Vanity combines an illuminated mirror with organised compartments in a compact case designed to keep everyday beauty essentials together at home or while travelling.' }}<div class="benefit-image-grid" style="margin-top:1rem"><figure><img src="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" alt="Illuminated mirror" style="aspect-ratio:4/3;object-fit:cover"><figcaption>Illuminated mirror for an even, clear finish</figcaption></figure><figure><img src="{{ 'livoara-product-white-sunlight.jpg' | asset_url }}" alt="Organised sections" style="aspect-ratio:4/3;object-fit:cover"><figcaption>Organised sections for everyday essentials</figcaption></figure></div></div></details><details class="info-row"><summary>Shipping & Returns<span>⌄</span></summary><p class="copy">Delivery estimates, serviceability, and any shipping charge are shown at checkout. Eligible return, refund, or exchange requests must be emailed to hello@livoara.in within 7 calendar days of delivery.</p></details><details class="info-row"><summary>Product Guidance<span>⌄</span></summary><p class="copy">Use the controls and power instructions supplied with your vanity. Capacity depends on the size and shape of each item.</p></details></div>
    </div>
  </section>
  <section id="customer-stories" class="section container-wide" style="border-top:1px solid var(--border)"><div style="text-align:center"><p class="eyebrow">Real routines</p><h2 class="title-lg" style="margin-top:.8rem">Trusted by Customers</h2><p class="copy" style="margin:1rem auto 0;max-width:42rem">Write your own review through the store contact form. Sample cards are shown for layout preview until verified customer reviews come in.</p></div>{% render 'sample-reviews' %}</section>
  <section class="section container-wide" style="border-top:1px solid var(--border)"><div class="split"><div><p class="eyebrow">See it in your routine</p><h2 class="title-lg" style="margin-top:.5rem">Designed to be used, beautifully.</h2></div><p class="copy">Three short LIVOARA films show organisation, light, and travel in one compact vanity format.</p></div><div class="film-grid" style="margin-top:1.75rem"><article class="video-card"><video src="{{ 'livoara-uploaded-organise.mp4' | asset_url }}" poster="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" autoplay muted loop playsinline controls></video><div class="card-pad"><h3>Organise with ease</h3><p class="copy">Dedicated compartments bring everyday essentials into one considered place.</p></div></article><article class="video-card"><video src="{{ 'livoara-uploaded-routine.mp4' | asset_url }}" poster="{{ 'livoara-product-white-sunlight.jpg' | asset_url }}" autoplay muted loop playsinline controls></video><div class="card-pad"><h3>Create your light</h3><p class="copy">The illuminated mirror supports your getting-ready routine wherever you set down the case.</p></div></article><article class="video-card"><video src="{{ 'livoara-uploaded-travel.mp4' | asset_url }}" poster="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" autoplay muted loop playsinline controls></video><div class="card-pad"><h3>Pack one beautiful case</h3><p class="copy">A compact vanity format keeps the mirror and beauty essentials together while travelling.</p></div></article></div></section>
  {% render 'comparison-section' %}
  <section id="reviews" class="section" style="background:var(--secondary)"><div class="container-wide"><div style="text-align:center;max-width:48rem;margin:auto"><p class="eyebrow">Customer comments</p><h2 class="title-lg" style="margin-top:.8rem">What India is saying</h2><p class="copy" style="margin-top:1rem">Illustrative sample comments for layout preview. Verified customer feedback should replace these after collection.</p></div>{% render 'comment-threads' %}</div></section>
  <div class="sticky-atc" data-sticky-atc><div class="sticky-inner"><img src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 }}{% else %}{{ 'livoara-product-pink-stacked.jpg' | asset_url }}{% endif %}" alt=""><div style="min-width:0"><p style="font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ product.title }}</p><p class="muted" style="font-size:.75rem">{{ current_variant.price | money }}</p></div><button class="button" style="margin-left:auto" onclick="document.querySelector('#ProductForm button[type=submit]').click()">Add to Cart</button></div></div>
</div>
{% schema %}{"name":"Main product","settings":[]} {% endschema %}
