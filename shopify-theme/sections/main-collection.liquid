<section class="section-large container"><p class="eyebrow">Collection</p><h1 class="title-xl" style="margin-top:.75rem">{{ collection.title | default: 'Shop' }}</h1>{% if collection.description != blank %}<div class="copy" style="margin-top:1rem;max-width:44rem">{{ collection.description }}</div>{% endif %}{% paginate collection.products by 24 %}{% if collection.products_count == 0 %}<div class="empty-state"><h2 class="title-md">No products found</h2><p class="copy">Create a product in Shopify and add it to this collection.</p></div>{% else %}<div class="collection-grid" style="margin-top:2rem">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}{% if paginate.pages > 1 %}<div style="display:flex;justify-content:center;gap:1rem;margin-top:2rem">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Collection grid","settings":[]} {% endschema %}