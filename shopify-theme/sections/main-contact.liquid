<section class="editorial-page"><p class="eyebrow">Customer care</p><h1 class="title-xl" style="margin-top:.75rem">We’re here to help.</h1><p class="copy" style="margin-top:1rem">For product, order, delivery, return, exchange, or other questions, contact our customer-care team.</p><div class="split" style="margin-top:3rem"><div>{% form 'contact' %}{% if form.posted_successfully? %}<p class="copy">Thank you. For immediate assistance, email hello@livoara.in with your order number where applicable.</p>{% endif %}{{ form.errors | default_errors }}<div class="field"><label for="ContactName">Name</label><input id="ContactName" name="contact[name]" required></div><div class="field" style="margin-top:1rem"><label for="ContactEmail">Email</label><input id="ContactEmail" name="contact[email]" type="email" required></div><div class="field" style="margin-top:1rem"><label for="ContactTopic">Topic</label><select id="ContactTopic" name="contact[topic]"><option>Product question</option><option>Order support</option><option>Return or exchange</option><option>Press & partnerships</option><option>Other</option></select></div><div class="field" style="margin-top:1rem"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea></div><button class="button" style="margin-top:1rem" type="submit">Send message</button>{% endform %}</div><aside class="copy-section"><h2 class="title-md">Business details</h2><p class="copy" style="margin-top:1rem"><strong>Legal business name</strong><br>ARINJJOY VENTURES<br><br><strong>Brand / trade name</strong><br>LIVOARA<br><br><strong>GSTIN</strong><br>21ACMFA2803PIZE<br><br><strong>Registered address</strong><br>Kalinga Nagar, Ghatikia, Bhubaneswar, Odisha – 751003<br><br><strong>Support email</strong><br>hello@livoara.in</p></aside></div></section>{% schema %}{"name":"Contact page","settings":[]} {% endschema %}