<section class="section-large container"><h1 class="title-xl">Your bag</h1>{% if cart.item_count == 0 %}<div class="empty-state"><p class="title-md">Your bag is waiting</p><a class="button" href="{{ routes.all_products_collection_url }}">Continue browsing</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post"><div style="margin-top:2rem">{% for item in cart.items %}<div class="cart-line" style="grid-template-columns:7rem minmax(0,1fr) auto"><img src="{{ item.image | image_url: width: 260 }}" alt="{{ item.image.alt | escape }}" style="width:7rem;height:8rem"><div><a href="{{ item.url }}"><h2>{{ item.product.title }}</h2></a><p class="muted">{{ item.variant.title }}</p><p>{{ item.final_line_price | money }}</p><label class="field" style="max-width:9rem;margin-top:.75rem"><span>Quantity</span><input name="updates[]" value="{{ item.quantity }}" min="0" type="number"></label></div><a class="button icon" href="{{ item.url_to_remove }}" aria-label="Remove {{ item.product.title }}">×</a></div>{% endfor %}</div><div style="border-top:1px solid var(--border);padding-top:1.5rem;margin-top:1.5rem;text-align:right"><p>Subtotal <strong class="price">{{ cart.total_price | money }}</strong></p><p class="copy">Taxes included. Shipping and delivery timeline are confirmed at checkout.</p><button class="button secondary" type="submit" name="update">Update cart</button><button class="button" type="submit" name="checkout">Secure checkout</button></div></form>{% endif %}</section>{% schema %}{"name":"Cart","settings":[]} {% endschema %}