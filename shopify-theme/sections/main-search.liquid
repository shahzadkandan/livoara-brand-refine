<section class="section-large container"><h1 class="title-xl">Search</h1><form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:1.5rem;display:flex;gap:.5rem"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search LIVOARA" style="flex:1;min-height:3rem;border:1px solid var(--border);background:var(--background);padding:.85rem"><button class="button" type="submit">Search</button></form>{% if search.performed %}<p class="copy" style="margin-top:1rem">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p><div class="collection-grid" style="margin-top:2rem">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article class="product-card"><div class="product-card-content"><a href="{{ item.url }}"><h2 class="title-md">{{ item.title }}</h2></a><p class="copy">{{ item.content | strip_html | truncate: 140 }}</p></div></article>{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Search","settings":[]} {% endschema %}