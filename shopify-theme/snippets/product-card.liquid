<article class="product-card"><a href="{{ product.url }}"><figure>{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% else %}<img src="{{ 'livoara-product-pink-stacked.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</figure></a><div class="product-card-content"><a href="{{ product.url }}"><h3 class="title-md">{{ product.title }}</h3></a><p class="copy">{{ product.description | strip_html | truncate: 120 }}</p><p class="price">{{ product.price | money }}</p><div class="product-card-actions"><form method="post" action="/cart/add" data-ajax-cart><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="button full" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to Cart{% else %}Sold out{% endif %}</button></form><a class="button secondary full" href="{{ product.url }}">View details</a></div></div></article>