<section class="section-large container"><h1 class="title-xl">{{ order.name }}</h1><p class="copy" style="margin-top:1rem">Placed on {{ order.created_at | date: '%d %b %Y' }}</p><div class="table-wrap" style="margin-top:2rem"><table class="orders-table"><thead><tr><th>Product</th><th>Quantity</th><th>Total</th></tr></thead><tbody>{% for line_item in order.line_items %}<tr><td>{{ line_item.title }}</td><td>{{ line_item.quantity }}</td><td>{{ line_item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table></div><p class="price" style="margin-top:1.5rem;text-align:right">{{ order.total_price | money }}</p></section>