<section class="section-large container"><h1 class="title-xl">Addresses</h1><p class="copy" style="margin-top:1rem"><a href="{{ routes.account_url }}">Back to account</a></p><div class="collection-grid" style="margin-top:2rem">{% for address in customer.addresses %}<article class="product-card"><div class="product-card-content"><div class="copy">{{ address | format_address }}</div>{% form 'customer_address', address %}<input type="hidden" name="_method" value="delete"><button class="button secondary" type="submit">Delete</button>{% endform %}</div></article>{% endfor %}</div><details class="info-row" open><summary>Add address <span>+</span></summary>{% form 'customer_address', customer.new_address %}<div class="field"><label>First name</label><input name="address[first_name]"></div><div class="field" style="margin-top:1rem"><label>Last name</label><input name="address[last_name]"></div><div class="field" style="margin-top:1rem"><label>Address</label><input name="address[address1]"></div><div class="field" style="margin-top:1rem"><label>City</label><input name="address[city]"></div><div class="field" style="margin-top:1rem"><label>Country</label><input name="address[country]" value="India"></div><div class="field" style="margin-top:1rem"><label>Postal code</label><input name="address[zip]"></div><button class="button" style="margin-top:1rem" type="submit">Add address</button>{% endform %}</details></section>