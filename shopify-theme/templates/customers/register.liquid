<section class="account-box"><h1 class="title-xl">Create account</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<div class="field"><label for="FirstName">First name</label><input name="customer[first_name]" id="FirstName" autocomplete="given-name"></div><div class="field" style="margin-top:1rem"><label for="LastName">Last name</label><input name="customer[last_name]" id="LastName" autocomplete="family-name"></div><div class="field" style="margin-top:1rem"><label for="Email">Email</label><input type="email" name="customer[email]" id="Email" autocomplete="email" required></div><div class="field" style="margin-top:1rem"><label for="Password">Password</label><input type="password" name="customer[password]" id="Password" required></div><button class="button full" style="margin-top:1rem" type="submit">Create account</button>{% endform %}</section>