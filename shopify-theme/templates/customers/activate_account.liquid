<section class="account-box"><h1 class="title-xl">Activate account</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<div class="field"><label>Password</label><input type="password" name="customer[password]"></div><div class="field" style="margin-top:1rem"><label>Confirm password</label><input type="password" name="customer[password_confirmation]"></div><button class="button full" style="margin-top:1rem">Activate account</button><button class="button secondary full" style="margin-top:.7rem" name="decline">Decline invitation</button>{% endform %}</section>