<section class="section-large container"><h1 class="title-xl">Account</h1><p class="copy" style="margin-top:1rem">Welcome, {{ customer.first_name | default: customer.email }}. <a href="{{ routes.account_logout_url }}">Sign out</a></p><div class="split" style="margin-top:2rem"><div><h2 class="title-md">Orders</h2>{% if customer.orders.size > 0 %}<div class="table-wrap"><table class="orders-table"><thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Total</th></tr></thead><tbody>{% for order in customer.orders %}<tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d %b %Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.total_price | money }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="copy">No orders yet.</p>{% endif %}</div><aside><h2 class="title-md">Default address</h2><div class="copy" style="margin-top:1rem">{{ customer.default_address | format_address }}</div><a class="button secondary" style="margin-top:1rem" href="{{ routes.account_addresses_url }}">Manage addresses</a></aside></div></section>